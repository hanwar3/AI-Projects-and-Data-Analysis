# Copy this file to ".env" and fill in whichever you want. Every one is FREE.
# The app runs without any of them, but each unlocks more coverage.

# ---------------------------------------------------------------------------
# USAJOBS - every US federal opening. US regions only.
# Highest value if you are searching the United States.
# Free key, ~2 minutes: https://developer.usajobs.gov/apirequest
# ---------------------------------------------------------------------------
USAJOBS_EMAIL=
USAJOBS_KEY=

# ---------------------------------------------------------------------------
# RELIEFWEB - UN OCHA's humanitarian job board, worldwide.
# The best single source for disaster risk / recovery / resilience roles
# outside the US. Register a free appname (they just want a contact):
# https://apidoc.reliefweb.int/parameters#appname
# ---------------------------------------------------------------------------
RELIEFWEB_APPNAME=

# ---------------------------------------------------------------------------
# ADZUNA - general job search across 20 countries (US, UK, CA, AU, DE, FR,
# NL, IN, ZA, and more). Free tier is generous.
# https://developer.adzuna.com/signup
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# APIFY - LinkedIn and Indeed, any country. The only source that costs money.
# The free plan includes $5/month of credit, which is roughly 12,000 LinkedIn
# results - far more than a focused search needs. The app enforces a monthly
# cap (budget_usd_per_month in the profile) and stops before exceeding it.
# https://console.apify.com  ->  Settings  ->  API & Integrations
# ---------------------------------------------------------------------------
APIFY_TOKEN=
